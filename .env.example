# Blank: a random one-time setup token is printed to server logs.
BOOTSTRAP_TOKEN=
# Loopback by default. Use 0.0.0.0 only to enable access from your LAN.
BIND_ADDRESS=127.0.0.1
PORT=3000
# Enable both for an HTTPS reverse proxy:
SECURE_COOKIE=false
# APP_ORIGIN=https://money.example.com
APP_ORIGIN=
